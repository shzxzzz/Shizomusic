{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShizoMusic realtime envelope",
  "type": "object",
  "required": ["version", "type", "payload"],
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "type": { "type": "string", "enum": ["presence.snapshot", "presence.update", "host.state", "playback.command", "queue.proposal", "queue.proposalDecision", "resync.request", "error"] },
    "payload": { "type": "object" }
  },
  "additionalProperties": true
}
